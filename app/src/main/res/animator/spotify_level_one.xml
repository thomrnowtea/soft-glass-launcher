<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="1100" android:repeatCount="infinite" android:interpolator="@android:interpolator/linear">
    <propertyValuesHolder android:propertyName="scaleY" android:valueType="floatType">
        <keyframe android:fraction="0" android:value="0.35" />
        <keyframe android:fraction="0.5" android:value="0.85" android:interpolator="@android:interpolator/accelerate_decelerate" />
        <keyframe android:fraction="1" android:value="0.35" android:interpolator="@android:interpolator/accelerate_decelerate" />
    </propertyValuesHolder>
</objectAnimator>
